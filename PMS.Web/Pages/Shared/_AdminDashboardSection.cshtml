<section class="mb-4">
<h1 class="hero-headline">Admin Dashboard</h1>
<p class="subtle mt-2 mb-0">Create projects, assign tasks, and monitor progress across the system.</p>
<section class="row g-3 mb-4">
    <div class="col-md-6">
        <article class="panel stat-card">
            <p class="subtle mb-1">Total Projects</p>
            <p class="stat-value mb-0">@Model.TotalProjects</p>
        </article>
    </div>
    <div class="col-md-6">
        <article class="panel stat-card">
            <p class="subtle mb-1">Average Progress Rate</p>
            <p class="stat-value mb-0">@Model.OverallAverageProgress%</p>
        </article>
    </div>
</section>
</section>