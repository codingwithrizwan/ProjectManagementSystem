@model PMS.Web.Pages.IndexModel
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="panel p-3 p-md-4">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 mb-0">Projects</h2>
        @if (Model.IsAdmin)
        {
            <a class="btn btn-sm btn-brand" asp-page="/Projects/Create">Create Project</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Task Count</th>
                    <th>Progress</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (IndexModel.ProjectCardVm item in Model.Projects)
                {
                    <tr>
                        <td>
                            <p class="fw-semibold mb-0">@item.Name</p>
                            <small class="subtle">@item.Description</small>
                        </td>
                        <td>@item.TaskCount</td>
                        <td style="min-width: 180px;">
                            <div class="project-progress"><span style="width:@item.Progress%"></span></div>
                            <small class="subtle">@item.Progress%</small>
                        </td>
                        <td>
                            <a asp-page="/Projects/Details" asp-route-id="@item.Id" class="btn btn-sm btn-brand">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
