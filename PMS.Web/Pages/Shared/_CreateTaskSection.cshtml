@model PMS.Web.Pages.IndexModel

<section class="panel p-3 p-md-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 mb-0">My Assigned Tasks</h2>
            <span class="subtle">@Model.EmployeeTasks.Count task(s)</span>
        </div>

        @if (Model.EmployeeTasks.Count == 0)
        {
            <p class="subtle mb-0">No task assigned yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Started</th>
                            <th>Completed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.EmployeeTasks)
                        {
                            <tr>
                                <td>@task.Title</td>
                                <td>@task.ProjectName</td>
                                <td>
                                    <span class="@task.StatusCssClass">@task.StatusText</span>
                                </td>
                                <td>@task.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>@task.StartedAtDisplay</td>
                                <td>@task.CompletedAtDisplay</td>
                                <td>
                                    <a asp-page="/Task" asp-route-taskId="@task.TaskId" class="btn btn-sm btn-primary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>